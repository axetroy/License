{
  "name": "license-xml",
  "version": "0.1.0",
  "description": "Issue and verify License XML v1.0 licenses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axetroy/license-xml.git"
  },
  "homepage": "https://github.com/axetroy/license-xml#readme",
  "bugs": {
    "url": "https://github.com/axetroy/license-xml/issues"
  },
  "keywords": [
    "license",
    "xml",
    "ed25519",
    "offline",
    "cryptography"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "files": [
    "src/",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "license-xml": "./src/cli.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "test:runtime": "node --test test/license.test.js",
    "check": "npm run lint && npm test && npm run docs:build && npm pack --dry-run",
    "build:playground": "node ./scripts/build-playground.js",
    "docs:build": "npm run build:playground && vitepress build docs",
    "docs:dev": "npm run build:playground && vitepress dev docs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "xml-crypto": "6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "vitepress": "^1.6.4",
    "xmldsigjs": "2.8.8"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
